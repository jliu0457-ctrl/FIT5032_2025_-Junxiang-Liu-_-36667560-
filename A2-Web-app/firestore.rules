rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- User profiles (BR C.2 / C.4): each user can only read/write their own doc ---
    // New profiles must be role 'Client'; role cannot be changed from the client
    // (promote to Admin via the Firebase console, see README-SETUP.md)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'Client';
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // --- Bookings (BR E.1): clients read-only; writes only via the Lambda function
    //     (service account bypasses these rules) ---
    match /bookings/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- Ratings (BR C.3): logged-in users rate; one rating doc per user+resource
    //     (doc id = {resourceId}_{uid}), so a user can only create/update THEIR OWN rating ---
    match /ratings/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.resource.data.userId == request.auth.uid
                            && request.resource.data.stars is number
                            && request.resource.data.stars >= 1
                            && request.resource.data.stars <= 5;
      allow delete: if false;
    }
  }
}